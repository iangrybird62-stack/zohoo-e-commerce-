# Copy to .env for local development. On Render, set these in the service's Environment tab instead.
# Never commit .env and never put any of these values in public/ files.

# Local port. Render sets PORT automatically; leave it unset there.
PORT=3000
# Set to "production" on Render. Startup then fails with a clear message if Razorpay variables are missing.
NODE_ENV=development
# Public URL of this backend (used in startup logs). On Render: https://YOUR-SERVICE.onrender.com
BASE_URL=http://localhost:3000
# Folder for the SQLite database. On Render use the persistent disk mount path, e.g. /var/data
DATA_DIR=./data
# Exact origin(s) of the separately hosted storefront, no path and no trailing slash.
# Comma-separate several (e.g. a custom domain plus the netlify.app one). Not needed when this server serves the site itself.
FRONTEND_URL=https://your-site-name.netlify.app

# Shipping (optional, whole rupees). Orders below FREE_SHIPPING_ABOVE pay SHIPPING_FEE; set SHIPPING_FEE=0 for free shipping on everything.
SHIPPING_FEE=99
FREE_SHIPPING_ABOVE=1499

# Razorpay (https://dashboard.razorpay.com/app/keys). Use rzp_test_ keys first, rzp_live_ keys only after testing.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Twilio (optional; without these, orders and payments still work and notifications are reported as not_configured)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# SMS-capable Twilio number in E.164 format
TWILIO_SMS_FROM=+15005550006
# WhatsApp sender, e.g. whatsapp:+14155238886 for the Twilio sandbox
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Your own WhatsApp number that receives new-order alerts
OWNER_WHATSAPP=whatsapp:+91XXXXXXXXXX
